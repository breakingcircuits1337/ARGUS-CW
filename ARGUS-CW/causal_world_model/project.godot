; Engine configuration file.
; Generated for: Causal World Model — DARPA Cyber Defense GT Framework
; Godot 4.3 (or later)

config_version=5

[application]
config/name="CausalWorldModel"
config/description="Game-theoretic causal world model for AI cyber defense — DARPA framework"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[autoload]
CausalEngine="*res://scripts/autoloads/CausalEngine.gd"
GameTheoryEngine="*res://scripts/autoloads/GameTheoryEngine.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/resizable=true
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="forward_plus"
environment/defaults/default_environment="res://default_env.tres"
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
scaling_3d/mode=0
lights_and_shadows/directional_shadow/size=4096
global_illumination/gi/use_half_resolution=false
textures/default_filters/anisotropic_filtering_level=4

[physics]
common/physics_fps=60
3d/default_gravity=0.0

[input]
# Camera orbit
orbit_drag={
"deadzone": 0.5,
"events": [Object(InputEventMouseButton,"resource_local_to_scene":false,"device":-1,"button_index":3,"pressed":false)]
}
# Scenario shortcuts
scenario_1={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":49)]}
scenario_2={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":50)]}
scenario_3={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":51)]}
scenario_4={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":52)]}
pause_sim={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":32)]}
reset_interventions={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":82)]}
deselect={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":4194305)]}
focus_atk_success={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":16777244)]}
focus_def_payoff={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":16777245)]}
focus_stackelberg={"deadzone":0.5,"events":[Object(InputEventKey,"resource_local_to_scene":false,"device":-1,"keycode":16777246)]}
